# Cesium ion access token (optional).
# Leave blank to run with OpenStreetMap imagery and ellipsoid terrain (no ion account needed).
# Get one free at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# CARTO basemap API key (optional). Only needed for ?basemap=carto-dark;
# CARTO watermarks tiles served without one. https://carto.com/basemaps/apikey
VITE_CARTO_API_KEY=
